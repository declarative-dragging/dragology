{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    // Check dragology's bundled index.d.ts too: that's half the point.
    "skipLibCheck": false
  },
  "include": ["src"]
}
